# ---------------------------------------------------------------------------
# Whitelist model: ignore EVERYTHING at the repo root, then re-include only
# source code. This guarantees org knowledgebases, incidents, uploaded/
# normalized logs, and user/auth data can never be committed by accident --
# even brand-new data folders are ignored unless explicitly re-included here.
# ---------------------------------------------------------------------------
/*

# Re-include source directories + this file
!/webapp/
!/scripts/
!/.gitignore
!/README.md

# ---------------------------------------------------------------------------
# Within the re-included dirs, still exclude anything that is DATA, not code.
# ---------------------------------------------------------------------------

# Web app runtime data: org knowledgebases, incidents, normalized-log library,
# and auth (users.json + tokens.json). Never commit any of this.
/webapp/data/
/webapp/logs/

# Real customer-org artifacts that were sitting next to the CLI scripts
/scripts/BoxSBJuly26/
/scripts/**/knowledge_base/
/scripts/**/incidents/

# ---------------------------------------------------------------------------
# SECRETS. The LLM connection is configured by environment variables, and the
# usual way to supply them is a file -- which means a live API key sits on
# disk next to the code. A bare `.env` rule is NOT enough: it matches only a
# file called exactly that, so `webapp/etc/ts-debug-helper.env` sailed
# straight past it and would have been committed.
#
# Match the extension anywhere, plus the local-config directory by name.
# ---------------------------------------------------------------------------
*.env
.env
.env.*
!*.env.example
/webapp/etc/

# Python / editor / OS noise
__pycache__/
*.pyc
*.pyo
*.tmp
.venv/
venv/
.DS_Store
Thumbs.db
node_modules/
.idea/
.vscode/
