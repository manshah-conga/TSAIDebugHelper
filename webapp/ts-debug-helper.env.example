# TS Intelligent Debug Helper -- local configuration template.
#
# HOW TO USE
#   Copy this file to ONE of the two places the app looks, in this order:
#
#       webapp/.env                        <- simplest, recommended
#       webapp/etc/ts-debug-helper.env     <- same filename the systemd unit uses
#
#   ...then restart the server. On startup it prints which file it loaded:
#
#       [TS Debug Helper] Loaded configuration from ...\webapp\.env
#       [TS Debug Helper] Shared LLM connection loaded (provider=azure,
#           deployment=gpt-4o, key FbHo...6o5x). Available to every signed-in user.
#
#   If it instead prints "No configuration file found. Looked for: ...", the
#   file is not in one of those paths -- the message lists exactly where it
#   looked. `TS_ENV_FILE=<path>` overrides the search if you need it elsewhere.
#
# DO NOT COMMIT YOUR COPY. It holds a live API key. The repo's .gitignore
# covers `*.env` and `webapp/etc/`, but check `git status` before committing
# anyway. Only this `.example` file belongs in version control.
#
# A value already set in the real environment always wins over this file, so
# under systemd the unit's EnvironmentFile= still takes precedence and you can
# override a single setting for one run from the shell.
#
# Format notes: `KEY=VALUE`, one per line. The value is split on the first `=`
# only, so an Azure URL's own `?api-version=` survives. Quotes are optional
# and stripped. A `#` after whitespace starts a comment.

# ---------------------------------------------------------------------------
# The shared LLM connection -- what makes chat work for every signed-in user.
# Pick ONE provider block.
# ---------------------------------------------------------------------------

# --- Azure OpenAI -----------------------------------------------------------
# TS_LLM_ENDPOINT must be the FULL chat-completions URL, not the resource
# root: the deployment in its path is what selects the model, and the app
# refuses a URL missing either the path or ?api-version=.
TS_LLM_PROVIDER=azure
TS_LLM_API_KEY=<your Azure OpenAI key>
TS_LLM_ENDPOINT=https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-08-01-preview

# --- OpenRouter (comment out the Azure block above if you use this) ---------
# TS_LLM_PROVIDER=openrouter
# TS_LLM_API_KEY=sk-or-v1-...
# TS_LLM_DEFAULT_MODEL=anthropic/claude-sonnet-4.5

# Which model new chats start on. Leave blank on Azure -- the deployment in
# the endpoint above already decides it, and the app fills this in for you.
TS_LLM_DEFAULT_MODEL=

# Optional. Set to 1 so non-admins cannot change model; they are then pinned
# to TS_LLM_DEFAULT_MODEL (or, on Azure, to the endpoint's deployment).
# TS_LLM_LOCK_MODEL=1

# ---------------------------------------------------------------------------
# Optional: everything below has a sensible default.
# ---------------------------------------------------------------------------

# First run only, to choose the bootstrap admin password instead of letting
# one be generated into the console. Remove it afterwards.
# TS_ADMIN_PASSWORD=change-me-on-first-login

# Per-turn budgets for the chat agent.
# TS_CHAT_MAX_TOOL_ROUNDS=25
# TS_CHAT_MAX_TOOL_RESULT_BYTES=24000
# TS_CHAT_TURN_SECONDS=300

# Public base URL, sent to OpenRouter so usage shows up attributed there.
# TS_PUBLIC_URL=https://ts-debug-helper.internal

# Refuse MCP tokens passed in the query string (?token=...). Set to 0 only
# while you still have clients that cannot send headers.
# TS_MCP_ALLOW_QUERY_TOKEN=1

# For the local stdio MCP server (mcp_server.py), not the web app.
# TS_DEBUG_HELPER_URL=http://127.0.0.1:8000
# TS_DEBUG_HELPER_TOKEN=<an API token created in the web UI>
